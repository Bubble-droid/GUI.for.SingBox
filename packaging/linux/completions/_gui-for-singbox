#compdef gui-for-singbox
#
# zsh completion for gui-for-singbox
#
# Install as /usr/share/zsh/site-functions/_gui-for-singbox (or place it in a
# directory listed in $fpath).

_gui-for-singbox() {
  _arguments -s \
    '(-h --help)'{-h,--help}'[Show help information]' \
    '(-v --version)'{-v,--version}'[Show version information]' \
    '(-q --quit)'{-q,--quit}'[Quit the running instance]' \
    '--data-dir=[Use a custom data directory for this run]:directory:_files -/' \
    '--portable[Keep data next to the application for this run]' \
    '--window-start-state=[Start the window normal or minimised for this run]:state:(normal minimised)' \
    '*:deep link or config file:_files'
}

_gui-for-singbox "$@"
