[Unit]
Description=GUI for SingBox Core Daemon
Documentation=https://github.com/Bubble-droid/GUI.for.SingBox
After=network-online.target
Wants=network-online.target
Requires=gui-for-singbox-daemon.socket
After=gui-for-singbox-daemon.socket

[Service]
Type=notify
ExecStart=/usr/lib/gui-for-singbox/gui-for-singbox-daemon \
  --socket /run/gui-for-singbox/daemon.sock \
  --state-dir /var/lib/gui-for-singbox \
  --runtime-dir /run/gui-for-singbox \
  --group gui-for-singbox \
  --stable-core /usr/lib/gui-for-singbox/cores/sing-box \
  --alpha-core /usr/lib/gui-for-singbox/cores/sing-box-alpha
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
KillMode=control-group
UMask=0077

StateDirectory=gui-for-singbox
StateDirectoryMode=0755
LimitNOFILE=1048576

# The daemon and the core keep full privileges, matching the official sing-box
# package. Filesystem and kernel sandboxes below narrow the attack surface.
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=no
ProtectProc=default
ProcSubset=all
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
ReadWritePaths=/var/lib/gui-for-singbox /run/gui-for-singbox
