post_install() {
	if ! getent group gui-for-singbox >/dev/null; then
		echo "==> Creating group 'gui-for-singbox'..."
		groupadd -r gui-for-singbox
	fi

	local caps="cap_net_admin,cap_net_raw,cap_net_bind_service+ep"
	local core_dir="/usr/lib/gui-for-singbox/cores"

	echo "==> Setting capabilities for sing-box cores..."

	if setcap "$caps" "$core_dir/sing-box"; then
		echo "  -> Stable core capabilities set successfully."
	else
		echo "  -> Warning: Failed to set capabilities for Stable core."
	fi

	if setcap "$caps" "$core_dir/sing-box-alpha"; then
		echo "  -> Alpha core capabilities set successfully."
	else
		echo "  -> Warning: Failed to set capabilities for Alpha core."
	fi

	echo ""
	echo "========================================================================="
	echo "  ==> IMPORTANT:"
	echo "      To allow GUI.for.SingBox to manage TUN and routing without root,"
	echo "      you MUST add your current user to the 'gui-for-singbox' group:"
	echo "      "
	echo "        sudo usermod -aG gui-for-singbox \$USER"
	echo "      "
	echo "      Please log out and log back in (or reboot) for this to take effect."
	echo "========================================================================="
	echo ""
}

post_upgrade() {
	post_install
}
