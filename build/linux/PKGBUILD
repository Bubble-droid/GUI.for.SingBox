# Maintainer: Bubble-droid
pkgname=gui-for-singbox-xdg
pkgver=dev
pkgrel=1
pkgdesc="A GUI client application for sing-box (XDG Base Directory Specification support)"
arch=('x86_64')
url="https://github.com/Bubble-droid/GUI.for.SingBox"
license=('GPL-3.0')
depends=('glibc>=2.31' 'webkit2gtk-4.1')
provides=('gui-for-singbox')
conflicts=('gui-for-singbox' 'gui.for.singbox')
options=('!strip' '!debug')
install="${pkgname}.install"

# CI 将会动态把这两个占位符替换为 SagerNet 最新的 Github Release 版本
_singbox_stable_ver="STABLE_VER_PLACEHOLDER"
_singbox_alpha_ver="ALPHA_VER_PLACEHOLDER"

source=(
	# 通用主程序包 (CI 前置步骤会准备好同名文件)
	"gui-for-singbox-linux-amd64.tar.gz"

	# 本地配套资源文件 (CI 会从 build 目录复制过来)
	"gui-for-singbox.desktop"
	"gui-for-singbox.rules"
	"gui-for-singbox.png"

	# 动态拉取指定版本的上游 glibc-amd64 核心
	"sing-box-stable.tar.gz::https://github.com/SagerNet/sing-box/releases/download/v${_singbox_stable_ver}/sing-box-${_singbox_stable_ver}-linux-amd64-glibc.tar.gz"
	"sing-box-alpha.tar.gz::https://github.com/SagerNet/sing-box/releases/download/v${_singbox_alpha_ver}/sing-box-${_singbox_alpha_ver}-linux-amd64-glibc.tar.gz"
)

# CI 会使用 updpkgsums 工具自动为上方所有文件计算并填充哈希
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
	# 1. 安装主二进制程序
	install -Dm755 "${srcdir}/gui-for-singbox" "${pkgdir}/usr/bin/gui-for-singbox"

	# 2. 安装本地捆绑资源 (根据您的规范要求设定)
	install -Dm644 "${srcdir}/gui-for-singbox.desktop" "${pkgdir}/usr/share/applications/gui-for-singbox.desktop"
	install -Dm644 "${srcdir}/gui-for-singbox.rules" "${pkgdir}/usr/share/polkit-1/rules.d/50-gui-for-singbox.rules"
	install -Dm644 "${srcdir}/gui-for-singbox.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/gui-for-singbox.png"

	# 3. 安装两个内核
	install -Dm755 "${srcdir}/sing-box-${_singbox_stable_ver}-linux-amd64-glibc/sing-box" \
		"${pkgdir}/usr/lib/gui-for-singbox/cores/sing-box"

	install -Dm755 "${srcdir}/sing-box-${_singbox_alpha_ver}-linux-amd64-glibc/sing-box" \
		"${pkgdir}/usr/lib/gui-for-singbox/cores/sing-box-alpha"
}
