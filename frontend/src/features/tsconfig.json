{
  "extends": "../../tsconfig.app.json",
  "compilerOptions": {
    // Style Options
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.features.tsbuildinfo"
  },
  "vueCompilerOptions": {
    "strictTemplates": true,
    "inferComponentDollarEl": true,
    "inferComponentDollarRefs": true,
    "inferTemplateDollarAttrs": true,
    "inferTemplateDollarEl": true,
    "inferTemplateDollarRefs": true,
    "inferTemplateDollarSlots": true,
    "fallthroughAttributes": true
  },
  "include": ["../../env.d.ts", "../**/*.d.ts", "./**/*.ts", "./**/*.vue"]
}
