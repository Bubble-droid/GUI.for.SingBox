#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "🧹 [Pre-commit] Checking staged code..."

# 1. Frontend formatting & linting
if [ -d "frontend" ]; then
  echo "==> [Frontend] Running lint-staged..."
  (cd frontend && pnpm lint-staged) || {
    echo "❌ [Frontend] lint-staged failed. Aborting commit!"
    exit 1
  }
fi

# 2. Go formatting
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACMR '*.go' 2>/dev/null || true)

if [ -n "$STAGED_GO_FILES" ]; then
  echo "==> [Backend] Checking Go formatting..."
  UNFORMATTED_FILES=""

  for file in $STAGED_GO_FILES; do
    DIFF=$(git show ":$file" | gofmt -d)
    if [ -n "$DIFF" ]; then
      UNFORMATTED_FILES="${UNFORMATTED_FILES}\n  - $file"
    fi
  done

  if [ -n "$UNFORMATTED_FILES" ]; then
    echo -e "❌ [Backend] The following Go files have formatting issues in the staged changes:${UNFORMATTED_FILES}"
    echo "💡 Please format the code with 'gofmt -w <file>' and stage your changes before committing."
    exit 1
  fi
fi

echo "✅ [Pre-commit] All checks passed successfully!"
