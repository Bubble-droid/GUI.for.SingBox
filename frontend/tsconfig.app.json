{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*.ts", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    // Extra safety for array and object lookups, but may have false positives.
    "noUncheckedIndexedAccess": true,

    "lib": ["ESNext", "DOM"],

    "paths": {
      "@wails/*": ["./src/bridge/wailsjs/*"],
      "@defaults": ["./src/features/defaults"],
      "@defaults/*": ["./src/features/defaults/*"],
      "@generator": ["./src/features/transformers/generator"],
      "@generator/*": ["./src/features/transformers/generator/*"],
      "@restorer": ["./src/features/transformers/restorer"],
      "@restorer/*": ["./src/features/transformers/restorer/*"],
      "@profiles": ["./src/features/types/profiles"],
      "@profiles/*": ["./src/features/types/profiles/*"],
      "@views/*": ["./src/features/views/*"],
      "@features/*": ["./src/features/*"],
      "@/*": ["./src/*"]
    },

    // Style Options
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,

    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "vueCompilerOptions": {
    "strictTemplates": true,
    "strictCssModules": true,
    "inferComponentDollarEl": true,
    "inferComponentDollarRefs": true,
    "inferTemplateDollarAttrs": true,
    "inferTemplateDollarEl": true,
    "inferTemplateDollarRefs": true,
    "inferTemplateDollarSlots": true,
    "fallthroughAttributes": true,
    "resolveStyleImports": true,
    "resolveStyleClassNames": true
  }
}
