{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "run-p -x type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "type-check": "golar tsc --build",
    "type-check:watch": "golar tsc --build --watch",
    "lint": "run-s -x \"lint:*\"",
    "lint:oxlint": "oxlint --fix --fix-suggestions .",
    "lint:eslint": "eslint --fix --cache .",
    "format": "oxfmt --no-error-on-unmatched-pattern src/",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.8",
    "codemirror": "^6.0.2",
    "croner": "10.0.1",
    "marked": "^18.0.9",
    "pinia": "^4.0.2",
    "prettier": "^3.9.6",
    "prismjs": "^1.30.0",
    "vue": "^3.5.41",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "11.4.8",
    "vue-router": "^5.2.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@golar/vue": "^0.1.10",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "26.1.2",
    "@types/prismjs": "^1.26.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "@zhexin/typebox": "^1.14.30",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.77.0",
    "eslint-plugin-vue": "^10.10.0",
    "golar": "^0.1.10",
    "husky": "^9.1.7",
    "less": "^4.8.1",
    "lint-staged": "^17.3.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "vite": "8.2.0"
  }
}
