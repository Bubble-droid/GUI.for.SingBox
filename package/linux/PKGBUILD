# Maintainer: Bubble-droid
pkgname=gui-for-singbox-xdg-full
pkgver=dev
pkgrel=1
pkgdesc="A GUI client application for sing-box with bundled cores (XDG support)"
arch=('x86_64')
url="https://github.com/Bubble-droid/GUI.for.SingBox"
license=('GPL3')
depends=('glibc>=2.31' 'libcap' 'webkit2gtk-4.1')
provides=('gui-for-singbox')
conflicts=('gui-for-singbox' 'gui-for-singbox-bin' 'gui.for.singbox' 'gui-for-singbox-xdg')
options=('!strip' '!debug')
install="postinst.sh"

_APP_VERSION=""
_STABLE_VERSION=""
_ALPHA_VERSION=""

source=(
	"gui-for-singbox.tar.gz::https://github.com/Bubble-droid/GUI.for.SingBox/releases/download/v${_APP_VERSION}/gui-for-singbox-${_APP_VERSION}-linux-amd64.tar.gz"

	"gui-for-singbox.desktop::https://raw.githubusercontent.com/Bubble-droid/GUI.for.SingBox/refs/heads/feat/xdg-base-directory/package/linux/gui-for-singbox.desktop"
	"gui-for-singbox.rules::https://raw.githubusercontent.com/Bubble-droid/GUI.for.SingBox/refs/heads/feat/xdg-base-directory/package/linux/gui-for-singbox.rules"
	"gui-for-singbox.png::https://raw.githubusercontent.com/Bubble-droid/GUI.for.SingBox/refs/heads/feat/xdg-base-directory/build/appicon.png"

	"sing-box-stable.tar.gz::https://github.com/SagerNet/sing-box/releases/download/v${_STABLE_VERSION}/sing-box-${_STABLE_VERSION}-linux-amd64-glibc.tar.gz"
	"sing-box-alpha.tar.gz::https://github.com/SagerNet/sing-box/releases/download/v${_ALPHA_VERSION}/sing-box-${_ALPHA_VERSION}-linux-amd64-glibc.tar.gz"
)

sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
	install -Dm755 "${srcdir}/gui-for-singbox" "${pkgdir}/usr/bin/gui-for-singbox"

	install -Dm644 "${srcdir}/gui-for-singbox.desktop" "${pkgdir}/usr/share/applications/gui-for-singbox.desktop"
	install -Dm644 "${srcdir}/gui-for-singbox.rules" "${pkgdir}/usr/share/polkit-1/rules.d/50-gui-for-singbox.rules"
	install -Dm644 "${srcdir}/gui-for-singbox.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/gui-for-singbox.png"

	install -Dm755 "${srcdir}/sing-box-${_STABLE_VERSION}-linux-amd64-glibc/sing-box" \
		"${pkgdir}/usr/lib/gui-for-singbox/cores/sing-box"

	install -Dm755 "${srcdir}/sing-box-${_ALPHA_VERSION}-linux-amd64-glibc/sing-box" \
		"${pkgdir}/usr/lib/gui-for-singbox/cores/sing-box-alpha"
}
